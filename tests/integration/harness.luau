-- A fake Tern that loads the whole plugin the way Tern does: window.luau and host.luau each in their own VM with a
-- global `tern`, relative `require`, a shared tern.kv, timers and process/HTTP callbacks that answer later, and a
-- reinstall that swaps the package folder and starts both halves again. omp and GitHub answer from fixtures.luau.
--
-- It also enforces Tern's budgets: a status formatter that runs a process, a request, a file or a kv read, or any
-- other callback that starts more than one process or request, is recorded in `world.violations` (Tern would
-- disable the plugin), and an error raised inside a callback goes to `world.errors`. A start that fails because
-- the binary is missing raises at once without creating a process, so it doesn't count.
local SOURCES = require("./sources") -- generated by `scripts/check.py --integration` from the package files
local FIXTURES = require("./fixtures")

local H = {}

local PLUGIN_DIR = "C:\\Users\\test\\AppData\\Roaming\\Tern\\plugins\\omp-usage"
local DATA_DIR = "C:\\Users\\test\\AppData\\Local\\Tern\\plugin-data\\omp-usage"
local LOCAL_APP = "C:\\Users\\test\\AppData\\Local"
H.OMP = LOCAL_APP .. "\\Tern\\omp\\bin\\omp.exe"
H.TERN = LOCAL_APP .. "\\Programs\\Tern\\tern.com"
H.SOURCE = "https://github.com/joaodutra88/tern-omp-usage"
H.FETCH_MS = 5 * 60 * 1000
-- What Windows answers when a folder being replaced is some process's working directory.
H.LOCKED = "tern plugin: The process cannot access the file because it is being used by another process. (os error 32)"

-- JSON, strictly: a malformed document raises, as tern.json.decode does.
local function decode(s: string): any
	local i = 1
	local function skip()
		i = string.find(s, "[^ \t\r\n]", i) or #s + 1
	end
	local function fail(what: string): any
		error(string.format("json: %s at byte %d", what, i), 0)
	end
	local ESC = { b = "\b", f = "\f", n = "\n", r = "\r", t = "\t", ['"'] = '"', ["\\"] = "\\", ["/"] = "/" }
	local function str(): string
		if string.sub(s, i, i) ~= '"' then
			return fail("expected a string")
		end
		local out, j = {}, i + 1
		while true do
			local c = string.sub(s, j, j)
			if c == '"' then
				i = j + 1
				return table.concat(out)
			elseif c == "\\" then
				local e = string.sub(s, j + 1, j + 1)
				if e == "u" then
					table.insert(out, utf8.char(tonumber(string.sub(s, j + 2, j + 5), 16) or fail("bad \\u")))
					j += 6
				else
					table.insert(out, ESC[e] or fail("bad escape"))
					j += 2
				end
			elseif c == "" then
				return fail("unterminated string")
			else
				local k = string.find(s, '["\\]', j) or #s + 1
				table.insert(out, string.sub(s, j, k - 1))
				j = k
			end
		end
	end
	local value: () -> any
	function value(): any
		skip()
		local c = string.sub(s, i, i)
		if c == "{" then
			local t = {}
			i += 1
			skip()
			if string.sub(s, i, i) == "}" then
				i += 1
				return t
			end
			while true do
				skip()
				local k = str()
				skip()
				if string.sub(s, i, i) ~= ":" then
					return fail("expected :")
				end
				i += 1
				t[k] = value()
				skip()
				local d = string.sub(s, i, i)
				i += 1
				if d == "}" then
					return t
				elseif d ~= "," then
					return fail("expected , or }")
				end
			end
		elseif c == "[" then
			local t, n = {}, 0
			i += 1
			skip()
			if string.sub(s, i, i) == "]" then
				i += 1
				return t
			end
			while true do
				n += 1
				t[n] = value()
				skip()
				local d = string.sub(s, i, i)
				i += 1
				if d == "]" then
					return t
				elseif d ~= "," then
					return fail("expected , or ]")
				end
			end
		elseif c == '"' then
			return str()
		end
		for word, v in { ["true"] = true, ["false"] = false } do
			if string.sub(s, i, i + #word - 1) == word then
				i += #word
				return v
			end
		end
		if string.sub(s, i, i + 3) == "null" then
			i += 4
			return nil
		end
		local num = string.match(s, "^-?%d+%.?%d*[eE]?[-+]?%d*", i)
		if not num or num == "" then
			return fail("unexpected " .. (if c == "" then "end" else c))
		end
		i += #num
		return tonumber(num)
	end
	local v = value()
	skip()
	if i <= #s then
		fail("trailing text")
	end
	return v
end
H.decode = decode

local function copy(v: any): any
	if type(v) ~= "table" then
		return v
	end
	local t = {}
	for k, x in v do
		t[k] = copy(x)
	end
	return t
end

-- `@T+n@` → now + n seconds in epoch ms; `@NAME@` → vars.NAME.
local function fill(text: string, vars: { [string]: any }): string
	local now_ms = os.time() * 1000
	return (string.gsub(text, "@([%w+-]+)@", function(name: string)
		local secs = string.match(name, "^T([+-]%d+)$")
		if secs then
			return tostring(now_ms + tonumber(secs) * 1000)
		end
		return tostring(assert(vars[name], "fixture variable " .. name .. " has no value"))
	end))
end
H.fill = fill

local function ui_node(kind: string): (...any) -> any
	return function(...)
		return { k = kind, args = { ... } }
	end
end
-- Only the builders host.luau uses; a new one fails loudly until it is added here.
local UI = setmetatable({
	span = function(t: string, s: string?)
		return { t = t, s = s }
	end,
	text = ui_node("text"),
	col = ui_node("col"),
	card = ui_node("card"),
	kv = ui_node("kv"),
	bars = ui_node("bars"),
	spark = ui_node("spark"),
	meter = ui_node("meter"),
	progress = ui_node("progress"),
}, {
	__index = function(_, name)
		error("tern.ui." .. tostring(name) .. " is not in the harness", 2)
	end,
})

-- Every string a view tree shows, in order (a span's text, not its style tokens).
function H.texts(node: any, out: { string }?): string
	local acc = out or {}
	if type(node) == "string" then
		table.insert(acc, node)
	elseif type(node) == "table" and type(node.t) == "string" then
		table.insert(acc, node.t)
	elseif type(node) == "table" then
		for _, v in (node.args or node) do
			H.texts(v, acc)
		end
	end
	return table.concat(acc, " ")
end

function H.world(opts: { [string]: any }?)
	local o = opts or {}
	local w: any = {
		files = copy(SOURCES), -- the package folder
		data = {}, -- the data folder (kv.json lives in w.kv)
		kv = {},
		vars = { C5 = 0.11, CWK = 0.2, CF = 0.03, X5 = 0, XWK = 0, VERSION = "0.0.1" },
		replies = {}, -- argv after the binary, joined by spaces → fixture text (overrides the defaults)
		omp_missing = false,
		github_status = 200,
		now = 0,
		seq = 0,
		gen = 0,
		events = {},
		toasts = {},
		opened = {},
		answers = {},
		spawned = {},
		violations = {},
		errors = {},
		panes = {},
		next_pane = 100,
		focused = nil,
		installs = 0,
	}
	if o.extras then
		w.files["extras.luau"] = o.extras
	end

	local function frame(kind: string, fn: (...any) -> ...any, ...): ...any
		local f = { kind = kind, spawns = 0, io = 0 }
		local prev = w.frame
		w.frame = f
		local res = table.pack(pcall(fn, ...))
		w.frame = prev
		if kind == "status" and f.spawns + f.io > 0 then
			table.insert(w.violations, string.format("status formatter: %d process/request, %d file/kv", f.spawns, f.io))
		elseif f.spawns > 1 then
			table.insert(w.violations, string.format("%s callback started %d processes/requests", kind, f.spawns))
		end
		if not res[1] then
			table.insert(w.errors, kind .. ": " .. tostring(res[2]))
			return nil
		end
		return table.unpack(res, 2, res.n)
	end
	local function count(what: "spawns" | "io")
		if w.frame then
			w.frame[what] += 1
		end
	end
	local function later(ms: number, kind: string, fn: (...any) -> (), ...)
		w.seq += 1
		table.insert(w.events, { at = w.now + ms, seq = w.seq, gen = w.gen, kind = kind, fn = fn, args = table.pack(...) })
	end

	local window_cx: () -> any
	function window_cx(): any
		return {
			toast = function(_, level: string, text: string, sub: string?)
				table.insert(w.toasts, { level = level, text = text, sub = sub })
			end,
			open = function(_, url: string)
				table.insert(w.opened, url)
			end,
			prompt = function(_, _opts)
				return {
					next = function(_, fn)
						local answer = table.remove(w.answers, 1)
						later(0, "prompt", fn, answer, nil, window_cx())
					end,
				}
			end,
			new_block = function(_, kind: string, args: { string }?, _how)
				return w:open_block(kind, args)
			end,
			session = {
				panes = function(_)
					local list = {}
					for id, p in w.panes do
						table.insert(list, { pane = id, title = if p.def.title then p.def.title(p.state) or "" else "" })
					end
					return list
				end,
			},
			layout = {
				focus = function(_, pane: number)
					w.focused = pane
				end,
			},
		}
	end
	w.cx = window_cx

	local function path_of(p: string): (string, string)
		if string.sub(p, 1, #DATA_DIR + 1) == DATA_DIR .. "/" or string.sub(p, 1, #DATA_DIR + 1) == DATA_DIR .. "\\" then
			return "data", string.sub(p, #DATA_DIR + 2)
		elseif not string.find(p, "^%a:[\\/]") and not string.find(p, "^/") then
			return "files", p
		end
		return "system", p
	end

	local function reply_for(argv: { string }, run_opts: any): { [string]: any }
		if argv[1] == H.TERN and argv[2] == "plugin" and argv[3] == "install" then
			w.installs += 1
			-- The default working directory, and any relative one, is the plugin's own folder.
			local cwd = run_opts.cwd
			if cwd == nil or path_of(cwd) == "files" or string.sub(cwd, 1, #PLUGIN_DIR) == PLUGIN_DIR then
				return { status = 1, stdout = "", stderr = H.LOCKED .. "\n" }
			end
			w.installed_from = argv[4]
			later(500, "install", function()
				w:reinstall(w.vars.VERSION)
			end)
			return { status = 0, stdout = "installed omp-usage", stderr = "" }
		end
		if w.omp_missing then
			error("tern.process.run " .. argv[1] .. ": No such file or directory (os error 2)")
		end
		local key = table.concat(argv, " ", 2)
		local default = ({
			["usage --json -p anthropic"] = FIXTURES.anthropic,
			["usage --json -p openai-codex"] = FIXTURES.codex,
			["stats --json"] = FIXTURES.stats,
			["usage --history --json --days 7"] = FIXTURES.history,
			["usage invalidate"] = "",
		})[key]
		local text = w.replies[key] or default
		if text == nil then
			return { status = 1, stdout = "", stderr = "no fixture for omp " .. key }
		end
		return { status = 0, stdout = fill(text, w.vars), stderr = "" }
	end

	local function make_tern(half: "window" | "host"): any
		local t: any = {
			getenv = function(name: string): string?
				return ({ LOCALAPPDATA = LOCAL_APP, USERPROFILE = "C:\\Users\\test" })[name]
			end,
			plugin = { id = "omp-usage", dir = PLUGIN_DIR, data = DATA_DIR },
			json = { decode = decode },
			kv = {
				get = function(key: string): any
					count("io")
					return copy(w.kv[key])
				end,
				set = function(key: string, value: any)
					count("io")
					w.kv[key] = copy(value)
				end,
			},
			fs = {
				exists = function(p: string): boolean
					count("io")
					local where, rel = path_of(p)
					if where == "system" then
						return rel == H.OMP or rel == H.TERN
					end
					return w[where][rel] ~= nil
				end,
				read = function(p: string): string
					count("io")
					local where, rel = path_of(p)
					local v = if where == "system" then nil else w[where][rel]
					return v or error("fs.read " .. p .. ": No such file or directory")
				end,
				write = function(p: string, text: string)
					count("io")
					local where, rel = path_of(p)
					assert(where ~= "system", "fs.write outside the plugin and data folders: " .. p)
					assert(where ~= "files", "fs.write inside the package folder reloads the plugin: " .. p)
					w[where][rel] = text
				end,
			},
			process = {
				run = function(argv: { string }, a, b)
					local run_opts = if type(a) == "table" then a else {}
					local cb = if type(a) == "function" then a else b
					table.insert(w.spawned, { argv = copy(argv), cwd = run_opts.cwd })
					local res = reply_for(argv, run_opts) -- raises, as Tern does, when the binary is missing
					count("spawns")
					later(10, "process", cb, res, if half == "window" then window_cx() else nil)
				end,
			},
			fetch = function(url: string, _opts, cb)
				count("spawns")
				table.insert(w.spawned, { argv = { "GET", url } })
				local res = if w.github_status == 200
					then { status = 200, body = fill(FIXTURES.release, w.vars), headers = {} }
					else { status = w.github_status, body = "{}", headers = {} }
				later(20, "fetch", cb, res, if half == "window" then window_cx() else nil)
			end,
			timer = function(ms: number, fn)
				local ev
				later(ms, "timer", function(...)
					if not ev.cancelled then
						fn(...)
					end
				end, if half == "window" then window_cx() else nil)
				ev = w.events[#w.events]
				return {
					cancel = function()
						ev.cancelled = true
					end,
				}
			end,
			chrome = {
				refresh = function() end,
				status = function(fn)
					w.formatter = fn
				end,
			},
			css = function(name: string, source: string)
				w.css = w.css or {}
				w.css[name] = source
			end,
			command = function(def)
				assert(half == "window", "tern.command is window only")
				w.commands["plugin.omp-usage." .. def.id] = def
			end,
			block = {
				define = function(id: string, def)
					assert(half == "host", "tern.block.define is host only")
					w.blocks["omp-usage." .. id] = def
				end,
			},
			pane = {
				list = function()
					local list = {}
					for id in w.panes do
						table.insert(list, { pane = id })
					end
					return list
				end,
			},
			ui = UI,
		}
		return t
	end

	-- One Luau VM per half: its own module cache, `tern` and `require` in the environment, like Tern's loader.
	local function vm(entry: string, half: "window" | "host")
		local cache: { [string]: any } = {}
		local env: any
		local function compile(src: string, name: string): any
			local chunk, err = loadstring(src, "=" .. name)
			if not chunk then
				error(err, 0)
			end
			setfenv(chunk, env)
			return chunk
		end
		env = setmetatable({
			tern = make_tern(half),
			loadstring = function(src: string, name: string?)
				return compile(src, name or "chunk")
			end,
			require = function(path: string): any
				local name = (string.match(path, "^%./(.+)$") or error("require needs ./name: " .. path)) .. ".luau"
				if cache[name] == nil then
					local src = w.files[name] or error("module not found: ./" .. name, 2)
					cache[name] = compile(src, name)()
				end
				return cache[name]
			end,
		}, { __index = getfenv(1) })
		frame("load " .. half, function()
			compile(assert(w.files[entry], entry .. " is missing"), entry)()
		end)
	end

	function w:load()
		self.gen += 1
		self.commands, self.blocks, self.formatter, self.panes = {}, {}, nil, {}
		vm("window.luau", "window")
		vm("host.luau", "host")
	end

	-- What `tern plugin install <repo> --force` leaves: the repository's files, so no extras.luau.
	function w:reinstall(version: string)
		local files = copy(SOURCES)
		files["plugin.toml"] = string.gsub(files["plugin.toml"], '\nversion = "[^"]+"', '\nversion = "' .. version .. '"')
		self.files = files
		self:load()
	end

	-- Runs every timer and callback due in the next `ms` of the fake clock; the old VMs' ones die with a reload.
	function w:run(ms: number)
		local stop = self.now + ms
		while true do
			local best, at = nil, nil
			for n, ev in self.events do
				if ev.at <= stop and (not best or ev.at < self.events[best].at or (ev.at == self.events[best].at and ev.seq < self.events[best].seq)) then
					best, at = n, ev.at
				end
			end
			if not best then
				break
			end
			local ev = table.remove(self.events, best)
			self.now = at
			if ev.gen == self.gen and ev.fn then
				frame(ev.kind, ev.fn, table.unpack(ev.args, 1, ev.args.n))
			end
		end
		self.now = stop
	end

	-- The status line text, and the set of commands its segments run.
	function w:bar(): (string, { [string]: boolean })
		local out = frame("status", self.formatter, { pane = 1, cwd = "C:\\work", title = "shell" }) or {}
		local texts, commands = {}, {}
		for _, seg in out do
			assert(type(seg) == "table" and type(seg.text) == "string", "a segment without text fails the formatter")
			table.insert(texts, seg.text)
			if seg.command then
				commands[seg.command] = true
			end
		end
		return table.concat(texts, ""), commands
	end

	-- Clicks a segment or picks a palette command.
	function w:click(action: string)
		local def = self.commands[action] or error("no command " .. action)
		frame("command " .. action, def.run, window_cx())
	end

	function w:open_block(kind: string, args: { string }?): number?
		local def = self.blocks[kind]
		if not def then
			return nil
		end
		self.next_pane += 1
		local id = self.next_pane
		local pane: any = { def = def }
		pane.cx = {
			pane = id,
			cols = 60,
			rows = 40,
			render = function()
				pane.renders = (pane.renders or 0) + 1
			end,
			toast = function(_, level: string, text: string, sub: string?)
				table.insert(w.toasts, { level = level, text = text, sub = sub })
			end,
			open = function(_, url: string)
				table.insert(w.opened, url)
			end,
		}
		self.panes[id] = pane
		self.focused = id
		later(0, "block init", function()
			pane.state = def.init(pane.cx, args or {}, nil)
		end)
		return id
	end

	function w:view(id: number): string
		local pane = self.panes[id]
		return H.texts(frame("block view", pane.def.view, pane.state, pane.cx))
	end

	function w:key(id: number, text: string)
		local pane = self.panes[id]
		frame("block key", pane.def.key, pane.state, { text = text, name = text, ctrl = false, alt = false, shift = false, meta = false }, pane.cx)
	end

	function w:toast_texts(): string
		local t = {}
		for _, x in self.toasts do
			table.insert(t, x.text .. (if x.sub then " · " .. x.sub else ""))
		end
		return table.concat(t, " | ")
	end

	return w
end

-- Fails with what was expected and what came out.
function H.expect(ok: any, what: string, got: any?)
	if not ok then
		error(what .. (if got ~= nil then "\n   got: " .. tostring(got) else ""), 2)
	end
end

return H
